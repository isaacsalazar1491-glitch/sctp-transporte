<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Unidades -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER"
            fx:controller="com.sctp.transporte.controller.UnidadesController">
    <VBox spacing="24">
        <padding><Insets top="32" right="40" bottom="40" left="40"/></padding>
        <HBox alignment="CENTER_LEFT">
            <Label text="Unidades" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Nueva unidad" styleClass="btn-accent" onAction="#nueva"/>
        </HBox>

        <HBox spacing="24" alignment="TOP_LEFT">
            <VBox styleClass="card, card-pad" HBox.hgrow="ALWAYS" prefWidth="640" minWidth="420">
                <TableView fx:id="tabla">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colPlaca" text="PLACA" sortable="false"/>
                        <TableColumn fx:id="colEco" text="N.º ECONÓMICO" sortable="false"/>
                        <TableColumn fx:id="colCapacidad" text="CAPACIDAD" sortable="false"/>
                        <TableColumn fx:id="colEstado" text="ESTADO" sortable="false"/>
                        <TableColumn fx:id="colAcciones" text="ACCIONES" sortable="false"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox styleClass="card, card-pad" prefWidth="380" minWidth="320" HBox.hgrow="SOMETIMES">
                <Label fx:id="tituloForm" text="Editar unidad" styleClass="h3"/>
                <Label fx:id="mensaje" maxWidth="Infinity"/>
                <VBox spacing="6">
                    <Label text="Placa" styleClass="field-label"/>
                    <TextField fx:id="placa"/>
                </VBox>
                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="N.º económico" styleClass="field-label"/>
                        <TextField fx:id="eco"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Capacidad" styleClass="field-label"/>
                        <TextField fx:id="capacidad"/>
                    </VBox>
                </HBox>
                <VBox spacing="6">
                    <Label text="Estado" styleClass="field-label"/>
                    <ComboBox fx:id="estado" maxWidth="Infinity"/>
                </VBox>
                <HBox spacing="12">
                    <Button fx:id="guardar" text="Guardar" styleClass="btn-accent" onAction="#guardar"/>
                    <Button fx:id="baja" text="Dar de baja" styleClass="btn-danger" onAction="#darDeBaja"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
