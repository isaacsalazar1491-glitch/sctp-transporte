<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.sctp.transporte.controller.RutasController" spacing="10.0" style="-fx-background-color: #ffffff; -fx-padding: 14; -fx-background-radius: 8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Gestión de Rutas"/>
                <TextField fx:id="txtBuscar" promptText="Buscar ruta..." style="-fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                <Button onAction="#handleNuevaRuta" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Nueva Ruta"/>
            </children>
        </HBox>

        <TableView VBox.vgrow="ALWAYS" fx:id="tablaRutas">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID"/>
                <TableColumn fx:id="colClave" prefWidth="90.0" text="Clave"/>
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre"/>
                <TableColumn fx:id="colOrigen" prefWidth="150.0" text="Origen"/>
                <TableColumn fx:id="colDestino" prefWidth="150.0" text="Destino"/>
                <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado"/>
            </columns>
        </TableView>
    </children>
</VBox>