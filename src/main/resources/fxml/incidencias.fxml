<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.sctp.transporte.controller.IncidenciasController" spacing="10.0" style="-fx-background-color: #ffffff; -fx-padding: 14; -fx-background-radius: 8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Gestión de Incidencias"/>
                <Button style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Registrar Incidencia"/>
            </children>
        </HBox>

        <TableView VBox.vgrow="ALWAYS" fx:id="tablaIncidencias">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
                <TableColumn fx:id="colRuta" prefWidth="180.0" text="Ruta"/>
                <TableColumn fx:id="colDescripcion" prefWidth="250.0" text="Descripción"/>
                <TableColumn fx:id="colFecha" prefWidth="130.0" text="Fecha / Hora"/>
            </columns>
        </TableView>
    </children>
</VBox>
