<?xml version="1.0" encoding="UTF-8"?>

<?import com.sctp.transporte.ui.MapaParadas?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Consulta pública (con mapa de paradas) -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="scroll" fitToWidth="true"
            hbarPolicy="NEVER" fx:controller="com.sctp.transporte.controller.ConsultaPublicaController">
    <VBox fx:id="contenido">
        <!-- Encabezado -->
        <VBox styleClass="hero">
            <HBox spacing="28" alignment="CENTER_LEFT">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Region styleClass="brand-logo"/>
                    <Label text="SCTP" styleClass="brand-text" style="-fx-font-size: 22px;"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Rutas" styleClass="nav-link" onAction="#irARutas"/>
                <Button text="Horarios" styleClass="nav-link" onAction="#irAHorarios"/>
                <Button text="Disponibilidad" styleClass="nav-link" onAction="#irADisponibilidad"/>
                <Button text="Acceso administrador" styleClass="btn-accent" onAction="#accesoAdmin"/>
            </HBox>
            <VBox spacing="10">
                <Label text="CONSULTA PÚBLICA · SIN REGISTRO" styleClass="hero-kicker"/>
                <Label text="¿A qué hora llega tu unidad?" styleClass="hero-title"/>
            </VBox>
        </VBox>

        <!-- Buscador -->
        <HBox styleClass="search-card" alignment="BOTTOM_LEFT" maxWidth="940">
            <VBox.margin><Insets top="-84" right="40" left="40"/></VBox.margin>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Ruta" styleClass="field-label"/>
                <ComboBox fx:id="comboRuta" maxWidth="Infinity" promptText="Elige una ruta"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Parada" styleClass="field-label"/>
                <ComboBox fx:id="comboParada" maxWidth="Infinity" promptText="Elige una parada"/>
            </VBox>
            <Button text="Consultar" styleClass="btn-accent" prefHeight="48" style="-fx-font-weight: 800;" onAction="#consultar"/>
        </HBox>

        <Label fx:id="mensaje" maxWidth="Infinity">
            <VBox.margin><Insets top="16" right="40" left="40"/></VBox.margin>
        </Label>

        <!-- Contenido -->
        <HBox spacing="24" alignment="TOP_LEFT">
            <padding><Insets top="24" right="40" bottom="40" left="40"/></padding>

            <!-- Mapa de paradas -->
            <VBox fx:id="seccionRutas" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="640" minWidth="420">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <padding><Insets top="20" right="24" bottom="14" left="24"/></padding>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Paradas de la ruta" styleClass="h2"/>
                        <Label text="Solo se muestran los puntos donde el camión sube o baja pasajeros." styleClass="muted" wrapText="true"/>
                    </VBox>
                    <Label fx:id="chipResumen" styleClass="chip, chip-neutral" style="-fx-font-size: 12px; -fx-padding: 6 12 6 12;"/>
                </HBox>
                <MapaParadas fx:id="mapa" prefHeight="380" minHeight="380" maxHeight="380"/>
                <FlowPane fx:id="listaParadas" hgap="12" vgap="12">
                    <padding><Insets top="16" right="24" bottom="22" left="24"/></padding>
                </FlowPane>
            </VBox>

            <!-- Columna derecha -->
            <VBox spacing="24" prefWidth="440" minWidth="380" HBox.hgrow="SOMETIMES">
                <VBox fx:id="seccionHorarios" styleClass="card, card-pad">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="tituloLlegadas" text="Próximas llegadas" styleClass="h3" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="Estimación" styleClass="chip-estimacion"/>
                    </HBox>
                    <TableView fx:id="tablaLlegadas" fixedCellSize="48" prefHeight="190" minHeight="190" maxHeight="190">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colSalida" text="SALIDA" sortable="false"/>
                            <TableColumn fx:id="colLlegada" text="LLEGADA" sortable="false"/>
                            <TableColumn fx:id="colUnidad" text="UNIDAD" sortable="false"/>
                            <TableColumn fx:id="colDias" text="DÍAS" sortable="false"/>
                        </columns>
                    </TableView>
                    <Label text="La hora es una estimación según el horario, no una medición en tiempo real." styleClass="muted-small" wrapText="true"/>
                </VBox>

                <VBox fx:id="seccionDisponibilidad" styleClass="card, card-pad">
                    <Label fx:id="tituloDisponibilidad" text="Disponibilidad" styleClass="h3"/>
                    <FlowPane fx:id="tarjetasUnidades" hgap="12" vgap="12"/>
                </VBox>

                <VBox styleClass="card, card-pad">
                    <Label text="Avisos en la ruta" styleClass="h3"/>
                    <VBox fx:id="avisos" spacing="10"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
