<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:controller="com.sctp.transporte.controller.AdminDashboardController" prefHeight="580.0" prefWidth="1020.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <!-- Menú lateral de administración -->
    <left>
        <VBox spacing="6.0" style="-fx-background-color: #0f172a; -fx-padding: 16; -fx-pref-width: 210;">
            <children>
                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" text="GESTIÓN DEL SISTEMA"/>
                <Button maxWidth="1.7976931348623157E308" onAction="#irConductores" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-cursor: hand;" text="👥 Conductores"/>
                <Button maxWidth="1.7976931348623157E308" onAction="#irUnidades" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-cursor: hand;" text="🚌 Unidades"/>
                <Button maxWidth="1.7976931348623157E308" onAction="#irRutas" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-cursor: hand;" text="🗺️ Rutas y Paradas"/>
                <Button maxWidth="1.7976931348623157E308" onAction="#irCorridas" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-cursor: hand;" text="🕒 Corridas y Salidas"/>
                <Button maxWidth="1.7976931348623157E308" onAction="#irIncidencias" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-cursor: hand;" text="⚠️ Incidencias"/>
            </children>
        </VBox>
    </left>

    <!-- Panel central donde cambian los módulos -->
    <center>
        <StackPane fx:id="panelCentral" style="-fx-padding: 16;">
            <children>
                <VBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Panel de Control Administrativo"/>
                        <Label style="-fx-text-fill: #64748b;" text="Elige un módulo en el menú de la izquierda para administrar la información."/>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>