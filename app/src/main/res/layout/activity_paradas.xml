<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- cabecera sctp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/lblTituloRutas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚏 Red de Rutas del Valle de Toluca"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblEstadoGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📡 Localizando GPS del dispositivo..."
            android:textColor="#cbd5e1"
            android:textSize="12sp" />

        <!-- tarjeta de informacion del autobus en vivo cuando hay ruta seleccionada -->
        <LinearLayout
            android:id="@+id/layoutInfoAutobus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#0f172a"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/lblRutaSeleccionada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚍 Monitoreo en vivo: R-01 Tianguistenco – Toluca"
                android:textColor="#38bdf8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblEstimacionLlegada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="⏱️ Autobús Eco. 14 en camino • Llegada estimada: Calculando..."
                android:textColor="#fde047"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- selector de vista: mapa interactivo o lista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="#0f172a"
            android:orientation="horizontal"
            android:padding="2dp">

            <Button
                android:id="@+id/btnVerMapa"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#047857"
                android:elevation="0dp"
                android:text="🗺️ Mapa Interactivo"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVerLista"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#1e293b"
                android:elevation="0dp"
                android:text="📋 Lista de Paradas"
                android:textColor="#cbd5e1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- vista del mapa webview con leaflet -->
        <WebView
            android:id="@+id/webViewMapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- vista de lista tradicional -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvParadas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone" />

        <!-- boton flotante para centrar en mi ubicacion actual -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMiUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:backgroundTint="#2563eb"
            android:contentDescription="Mi Ubicación"
            android:src="@android:drawable/ic_menu_mylocation"
            android:tint="#ffffff" />

        <ProgressBar
            android:id="@+id/progressBarParadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

</LinearLayout>
